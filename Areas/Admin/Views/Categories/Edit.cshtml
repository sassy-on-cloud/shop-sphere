@model CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}
<div class="admin-page-heading">
    <div>
        <a class="admin-back-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">← Categories</a>
        <p class="admin-eyebrow">CATALOG</p>
        <h1>Edit category</h1>
        <p class="admin-page-subtitle">Update the category details shown in the storefront.</p>
    </div>
</div>
<section class="admin-panel admin-form-panel admin-narrow-form">
    <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.CategoryId" method="post">
        <partial name="_CategoryForm" model="Model" />
        <div class="admin-form-actions">
            <a class="btn admin-secondary-button" asp-area="Admin" asp-controller="Categories" asp-action="Index">Cancel</a>
            <button class="btn admin-primary-button" type="submit">Save changes</button>
        </div>
    </form>
</section>
