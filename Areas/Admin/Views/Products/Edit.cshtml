@model ProductFormViewModel
@{
    ViewData["Title"] = "Edit product";
}
<div class="admin-page-heading">
    <div>
        <a class="admin-back-link" asp-area="Admin" asp-controller="Products" asp-action="Index">← Products</a>
        <p class="admin-eyebrow">CATALOG</p>
        <h1>Edit product</h1>
        <p class="admin-page-subtitle">Changes to price and stock take effect immediately.</p>
    </div>
</div>
<section class="admin-panel admin-form-panel">
    <form asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@Model.ProductId" method="post" enctype="multipart/form-data">
        <partial name="_ProductForm" model="Model" />
        <div class="admin-form-actions">
            <a class="btn admin-secondary-button" asp-area="Admin" asp-controller="Products" asp-action="Index">Cancel</a>
            <button class="btn admin-primary-button" type="submit">Save changes</button>
        </div>
    </form>
</section>
