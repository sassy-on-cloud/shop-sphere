@model ProductFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
<div class="admin-form-grid">
    <div class="admin-form-main">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" autocomplete="off" />
        <span asp-validation-for="ProductName" class="text-danger"></span>

        <label asp-for="Description" class="form-label mt-3"></label>
        <textarea asp-for="Description" class="form-control" rows="7"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="admin-form-aside">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="0">Choose a category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>

        <label asp-for="Price" class="form-label mt-3"></label>
        <div class="input-group">
            <span class="input-group-text">NPR</span>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
        </div>
        <span asp-validation-for="Price" class="text-danger"></span>

        <label asp-for="DiscountPercentage" class="form-label mt-3"></label>
        <div class="input-group">
            <input asp-for="DiscountPercentage" class="form-control" type="number" step="0.01" min="0" max="100" />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="DiscountPercentage" class="text-danger"></span>

        <label asp-for="StockQuantity" class="form-label mt-3"></label>
        <input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" />
        <span asp-validation-for="StockQuantity" class="text-danger"></span>

        <label asp-for="Image" class="form-label mt-3"></label>
        <input asp-for="Image" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
        <span asp-validation-for="Image" class="text-danger"></span>
        <small class="form-text">JPEG, PNG, or WebP; maximum 5 MB.</small>
        @if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
        {
            <div class="admin-current-image">
                <img src="@Model.CurrentImageUrl" alt="Current product image" />
                <span>Current image</span>
            </div>
        }
    </div>
</div>
