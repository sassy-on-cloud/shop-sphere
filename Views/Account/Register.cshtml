@model RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
}

<section class="container auth-page">
    <div class="auth-card">
        <p class="section-kicker">Join ShopSphere</p>
        <h1>Create your account</h1>
        <p class="auth-intro">A few details and you’re ready to discover your next favorite.</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="auth-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="FullName" class="field-validation"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>
            <div class="auth-field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="field-validation"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
                <small>Use at least 10 characters, including uppercase, lowercase, a number, and a symbol.</small>
            </div>
            <div class="auth-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>
            <button class="auth-submit" type="submit">Create account</button>
        </form>
        <p class="auth-switch">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
