@model ShopSphere.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Discover great finds";
}

<div class="home-page">
    <section class="hero-wrap">
        <div class="container">
            <div class="hero-banner">
                <img class="hero-image" src="https://images.unsplash.com/photo-1607082349566-187342175e2f?auto=format&fit=crop&w=1500&q=85" alt="" />
                <div class="hero-orbit" aria-hidden="true"></div>
                <div class="hero-copy">
                    <span class="eyebrow">The everyday edit</span>
                    <h1>Find a little more of what you love.</h1>
                    <p>Good things, great prices, and a whole lot of inspiration - all in one place.</p>
                    <a class="hero-cta" href="#featured">Explore the collection <span aria-hidden="true">→</span></a>
                </div>
                <div class="hero-discount" aria-label="Up to 50 percent off">
                    <strong>50%</strong>
                    <span>up to off</span>
                </div>
            </div>

            <div class="service-highlights" aria-label="ShopSphere benefits">
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">↗</span>
                    <div><strong>Easy delivery</strong><span>Across Nepal</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">✓</span>
                    <div><strong>Quality picks</strong><span>Curated for you</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">↺</span>
                    <div><strong>Easy returns</strong><span>Shop with confidence</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">♡</span>
                    <div><strong>Everyday value</strong><span>Great finds, fair prices</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="container content-section" id="categories">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Browse your way</p>
                <h2>Shop by category</h2>
            </div>
            <a class="text-link" asp-controller="Product" asp-action="Categories">Explore all <span aria-hidden="true">→</span></a>
        </div>
        <div class="category-grid">
            @foreach (var category in Model.Categories)
            {
                <a class="category-card" asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.CategoryId">
                    <span class="category-art"><img src="@category.ImageUrl" alt="" loading="lazy" /></span>
                    <strong>@category.CategoryName</strong>
                </a>
            }
        </div>
    </section>

    <section class="container content-section" id="flash-deals">
        <div class="deal-section">
            <div class="section-heading deal-heading">
                <div class="deal-title-wrap">
                    <span class="deal-bolt" aria-hidden="true">ϟ</span>
                    <div>
                        <p class="section-kicker">Handpicked for today</p>
                        <h2>Flash deals</h2>
                    </div>
                </div>
                <div class="deal-timer" data-countdown aria-label="Flash deals time remaining">
                    <span>Ends in</span>
                    <span class="timer-unit" data-hours>03</span><span>:</span>
                    <span class="timer-unit" data-minutes>42</span><span>:</span>
                    <span class="timer-unit" data-seconds>18</span>
                </div>
                <a class="text-link" asp-controller="Product" asp-action="Index" asp-route-sort="price-desc">See all deals <span aria-hidden="true">→</span></a>
            </div>
            <div class="product-grid">
                @foreach (var product in Model.FlashDeals)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>

    <section class="container featured-section" id="featured">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Good finds, picked for you</p>
                <h2>Popular right now</h2>
            </div>
            <p>Fresh favorites from across the store</p>
            <a class="text-link" asp-controller="Product" asp-action="Index">View all <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-grid">
            @foreach (var product in Model.FeaturedProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="container" aria-label="Seasonal collection">
        <div class="editorial-banner">
            <div>
                <p class="section-kicker">Make room for good things</p>
                <h2>Little upgrades. Big everyday joy.</h2>
                <p>Thoughtful picks for the way you live, work, and unwind.</p>
            </div>
            <span class="editorial-art" aria-hidden="true">✳</span>
            <a class="hero-cta" href="#featured">Find your next favorite <span aria-hidden="true">→</span></a>
        </div>
    </section>
</div>
