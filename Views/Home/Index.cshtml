@using ShopSphere.Models
@{
    ViewData["Title"] = "Discover great finds";

    var flashDeals = new[]
    {
        new ProductCardViewModel("Cloud-soft everyday sneakers", "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=720&q=85", 2499, 3999, 38, 4.8, 126, "Selling fast"),
        new ProductCardViewModel("Studio wireless headphones", "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=720&q=85", 1899, 2999, 37, 4.7, 84, "Almost gone"),
        new ProductCardViewModel("Minimal everyday wristwatch", "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=720&q=85", 3299, 5499, 40, 4.9, 52, "Popular pick"),
        new ProductCardViewModel("Compact instant camera", "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=720&q=85", 7499, 9999, 25, 4.6, 39, "Deal of the day")
    };

    var featuredProducts = new[]
    {
        new ProductCardViewModel("Classic over-ear headphones", "https://images.unsplash.com/photo-1583394838336-acd977736f90?auto=format&fit=crop&w=720&q=85", 2199, 3499, 37, 4.8, 211, ""),
        new ProductCardViewModel("Everyday cotton crew tee", "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=720&q=85", 899, 1499, 40, 4.5, 96, ""),
        new ProductCardViewModel("Lightweight city backpack", "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=720&q=85", 1799, 2599, 31, 4.7, 143, ""),
        new ProductCardViewModel("Daily hydration bottle", "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=720&q=85", 699, 1099, 36, 4.6, 74, ""),
        new ProductCardViewModel("Fresh notes eau de parfum", "https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=720&q=85", 1599, 2299, 30, 4.8, 58, ""),
        new ProductCardViewModel("Modern analog watch", "https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=720&q=85", 2899, 4299, 33, 4.7, 112, ""),
        new ProductCardViewModel("Soft knit home throw", "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=720&q=85", 1999, 2799, 29, 4.6, 67, ""),
        new ProductCardViewModel("Everyday running trainers", "https://images.unsplash.com/photo-1543163521-1bf539c55dd2?auto=format&fit=crop&w=720&q=85", 2799, 3999, 30, 4.7, 88, "")
    };
}

<div class="home-page">
    <section class="hero-wrap">
        <div class="container">
            <div class="hero-banner">
                <img class="hero-image" src="https://images.unsplash.com/photo-1607082349566-187342175e2f?auto=format&fit=crop&w=1500&q=85" alt="" />
                <div class="hero-orbit" aria-hidden="true"></div>
                <div class="hero-copy">
                    <span class="eyebrow">The everyday edit</span>
                    <h1>Find a little more of what you love.</h1>
                    <p>Good things, great prices, and a whole lot of inspiration - all in one place.</p>
                    <a class="hero-cta" href="#featured">Explore the collection <span aria-hidden="true">→</span></a>
                </div>
                <div class="hero-discount" aria-label="Up to 50 percent off">
                    <strong>50%</strong>
                    <span>up to off</span>
                </div>
            </div>

            <div class="service-highlights" aria-label="ShopSphere benefits">
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">↗</span>
                    <div><strong>Easy delivery</strong><span>Across Nepal</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">✓</span>
                    <div><strong>Quality picks</strong><span>Curated for you</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">↺</span>
                    <div><strong>Easy returns</strong><span>Shop with confidence</span></div>
                </div>
                <div class="service-item">
                    <span class="service-icon" aria-hidden="true">♡</span>
                    <div><strong>Everyday value</strong><span>Great finds, fair prices</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="container content-section" id="categories">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Browse your way</p>
                <h2>Shop by category</h2>
            </div>
            <a class="text-link" href="#featured">Explore all <span aria-hidden="true">→</span></a>
        </div>
        <div class="category-grid">
            <a class="category-card" href="#featured"><span class="category-art fashion" aria-hidden="true">👟</span><strong>Fashion</strong></a>
            <a class="category-card" href="#featured"><span class="category-art electronics" aria-hidden="true">🎧</span><strong>Electronics</strong></a>
            <a class="category-card" href="#featured"><span class="category-art home" aria-hidden="true">🛋️</span><strong>Home &amp; living</strong></a>
            <a class="category-card" href="#featured"><span class="category-art beauty" aria-hidden="true">🧴</span><strong>Beauty</strong></a>
            <a class="category-card" href="#featured"><span class="category-art sports" aria-hidden="true">🏃</span><strong>Sports &amp; outdoors</strong></a>
            <a class="category-card" href="#featured"><span class="category-art grocery" aria-hidden="true">🥑</span><strong>Grocery</strong></a>
        </div>
    </section>

    <section class="container content-section" id="flash-deals">
        <div class="deal-section">
            <div class="section-heading deal-heading">
                <div class="deal-title-wrap">
                    <span class="deal-bolt" aria-hidden="true">ϟ</span>
                    <div>
                        <p class="section-kicker">Handpicked for today</p>
                        <h2>Flash deals</h2>
                    </div>
                </div>
                <div class="deal-timer" data-countdown aria-label="Flash deals time remaining">
                    <span>Ends in</span>
                    <span class="timer-unit" data-hours>03</span><span>:</span>
                    <span class="timer-unit" data-minutes>42</span><span>:</span>
                    <span class="timer-unit" data-seconds>18</span>
                </div>
                <a class="text-link" href="#featured">See all deals <span aria-hidden="true">→</span></a>
            </div>
            <div class="product-grid">
                @foreach (var product in flashDeals)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>

    <section class="container featured-section" id="featured">
        <div class="section-heading">
            <div>
                <p class="section-kicker">Good finds, picked for you</p>
                <h2>Popular right now</h2>
            </div>
            <p>Fresh favorites from across the store</p>
            <a class="text-link" href="#categories">View all <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-grid">
            @foreach (var product in featuredProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="container" aria-label="Seasonal collection">
        <div class="editorial-banner">
            <div>
                <p class="section-kicker">Make room for good things</p>
                <h2>Little upgrades. Big everyday joy.</h2>
                <p>Thoughtful picks for the way you live, work, and unwind.</p>
            </div>
            <span class="editorial-art" aria-hidden="true">✳</span>
            <a class="hero-cta" href="#featured">Find your next favorite <span aria-hidden="true">→</span></a>
        </div>
    </section>
</div>
