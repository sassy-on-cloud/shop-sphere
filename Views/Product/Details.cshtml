@model ShopSphere.Models.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.ProductName;
}

<section class="container product-details-page">
    <a class="product-back-link" asp-controller="Product" asp-action="Index">← Back to products</a>
    <div class="product-details-card">
        <div class="product-details-image">
            <img src="@Model.Product.ImageUrl" alt="@Model.Product.ProductName" />
            @if (Model.Product.DiscountPercentage > 0)
            {
                <span class="product-badge">@Model.Product.DiscountPercentage.ToString("0.#")% OFF</span>
            }
        </div>
        <div class="product-details-copy">
            <a class="product-details-category" asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId">
                @Model.Product.Category.CategoryName
            </a>
            <h1>@Model.Product.ProductName</h1>
            <div class="product-details-price">
                <strong>NPR @Model.CurrentPrice.ToString("N2")</strong>
                @if (Model.Product.DiscountPercentage > 0)
                {
                    <del>NPR @Model.Product.Price.ToString("N2")</del>
                    <span>@Model.Product.DiscountPercentage.ToString("0.#")% off</span>
                }
            </div>
            <p class="product-availability @(Model.Product.StockQuantity > 0 ? "available" : "unavailable")">
                <span aria-hidden="true">●</span>
                @if (Model.Product.StockQuantity > 0)
                {
                    <text>In stock · @Model.Product.StockQuantity available</text>
                }
                else
                {
                    <text>Currently out of stock</text>
                }
            </p>
            @if (Model.Product.StockQuantity > 0)
            {
                <form class="product-details-cart-form" asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="ProductId" value="@Model.Product.ProductId" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" />
                    <label for="productQuantity">Quantity</label>
                    <input id="productQuantity" class="form-control" type="number" name="Quantity" min="1" max="@Model.Product.StockQuantity" value="1" />
                    <button class="cart-primary-button" type="submit">Add to bag</button>
                </form>
            }
            <div class="product-details-description">
                <h2>About this product</h2>
                <p>@Model.Product.Description</p>
            </div>
            <div class="product-details-note">Prices are shown in Nepalese rupees (NPR).</div>
        </div>
    </div>

    @if (Model.RelatedProducts.Count > 0)
    {
        <section class="related-products-section" aria-labelledby="relatedProductsHeading">
            <div class="section-heading">
                <div>
                    <p class="section-kicker">More from @Model.Product.Category.CategoryName</p>
                    <h2 id="relatedProductsHeading">You might also like</h2>
                </div>
                <a class="text-link" asp-controller="Product" asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId">
                    Shop this category <span aria-hidden="true">→</span>
                </a>
            </div>
            <div class="product-grid">
                @foreach (var product in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>
    }
</section>
