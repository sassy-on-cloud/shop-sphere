@model ShopSphere.Models.ProductCatalogViewModel
@{
    var firstResult = Model.TotalProducts == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    var lastResult = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalProducts);
}

<section class="container catalog-page">
    <div class="catalog-heading">
        <div>
            <p class="section-kicker">Find your next favorite</p>
            <h1>@(Model.SelectedCategoryName ?? (string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Shop all products" : "Search results"))</h1>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p class="catalog-subtitle">Results for <strong>“@Model.SearchTerm”</strong></p>
            }
            else
            {
                <p class="catalog-subtitle">Explore the ShopSphere collection, all in one place.</p>
            }
        </div>
        <a class="text-link" asp-action="Categories">Browse categories <span aria-hidden="true">→</span></a>
    </div>

    <div class="catalog-layout">
        <aside class="catalog-sidebar" aria-label="Product filters">
            <form asp-action="Index" method="get" class="catalog-filter-form">
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <input type="hidden" name="q" value="@Model.SearchTerm" />
                }
                <input type="hidden" name="sort" value="@Model.Sort" />

                <div class="filter-header">
                    <h2>Filters</h2>
                    <a asp-action="Index" class="filter-clear">Clear all</a>
                </div>

                <div class="filter-group">
                    <label for="categoryId">Category</label>
                    <select class="form-select" id="categoryId" name="categoryId">
                        <option value="">All categories</option>
                        @foreach (var category in Model.Categories)
                        {
                            if (Model.CategoryId == category.CategoryId)
                            {
                                <option value="@category.CategoryId" selected>@category.CategoryName</option>
                            }
                            else
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        }
                    </select>
                </div>

                <fieldset class="filter-group">
                    <legend>Price after discount (NPR)</legend>
                    <div class="price-range-inputs">
                        <label>
                            <span class="visually-hidden">Minimum price</span>
                            <input class="form-control" type="number" name="minimumPrice" min="0" max="9999999999999999.99" step="0.01" value="@Model.MinimumPrice" placeholder="Min" />
                        </label>
                        <span aria-hidden="true">–</span>
                        <label>
                            <span class="visually-hidden">Maximum price</span>
                            <input class="form-control" type="number" name="maximumPrice" min="0" max="9999999999999999.99" step="0.01" value="@Model.MaximumPrice" placeholder="Max" />
                        </label>
                    </div>
                </fieldset>

                <div class="filter-group">
                    <label for="available">Availability</label>
                    <select class="form-select" id="available" name="available">
                        @if (Model.Available is null)
                        {
                            <option value="" selected>Any availability</option>
                        }
                        else
                        {
                            <option value="">Any availability</option>
                        }
                        @if (Model.Available == true)
                        {
                            <option value="true" selected>In stock</option>
                        }
                        else
                        {
                            <option value="true">In stock</option>
                        }
                        @if (Model.Available == false)
                        {
                            <option value="false" selected>Out of stock</option>
                        }
                        else
                        {
                            <option value="false">Out of stock</option>
                        }
                    </select>
                </div>

                <button class="filter-apply" type="submit">Apply filters</button>
            </form>
        </aside>

        <div class="catalog-results">
            <div class="catalog-toolbar">
                <p>
                    @if (Model.TotalProducts == 0)
                    {
                        <span>No products found</span>
                    }
                    else
                    {
                        <span>Showing <strong>@firstResult–@lastResult</strong> of <strong>@Model.TotalProducts</strong> products</span>
                    }
                </p>
                <form asp-action="Index" method="get" class="catalog-sort-form">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <input type="hidden" name="q" value="@Model.SearchTerm" />
                    }
                    @if (Model.MinimumPrice.HasValue)
                    {
                        <input type="hidden" name="minimumPrice" value="@Model.MinimumPrice.Value" />
                    }
                    @if (Model.MaximumPrice.HasValue)
                    {
                        <input type="hidden" name="maximumPrice" value="@Model.MaximumPrice.Value" />
                    }
                    @if (Model.CategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.CategoryId.Value" />
                    }
                    @if (Model.Available.HasValue)
                    {
                        <input type="hidden" name="available" value="@Model.Available.Value.ToString().ToLowerInvariant()" />
                    }
                    <label for="catalogSort">Sort by</label>
                    <select id="catalogSort" name="sort" class="form-select" onchange="this.form.submit()">
                        @if (Model.Sort == "newest")
                        {
                            <option value="newest" selected>Newest first</option>
                        }
                        else
                        {
                            <option value="newest">Newest first</option>
                        }
                        @if (Model.Sort == "price-asc")
                        {
                            <option value="price-asc" selected>Price: low to high</option>
                        }
                        else
                        {
                            <option value="price-asc">Price: low to high</option>
                        }
                        @if (Model.Sort == "price-desc")
                        {
                            <option value="price-desc" selected>Price: high to low</option>
                        }
                        else
                        {
                            <option value="price-desc">Price: high to low</option>
                        }
                        @if (Model.Sort == "name")
                        {
                            <option value="name" selected>Name: A–Z</option>
                        }
                        else
                        {
                            <option value="name">Name: A–Z</option>
                        }
                    </select>
                </form>
            </div>

            @if (Model.Products.Count == 0)
            {
                <div class="catalog-empty">
                    <span class="empty-search-icon" aria-hidden="true">⌕</span>
                    <h2>No products found</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <p>We couldn’t find products matching “@Model.SearchTerm”. Try a different search or clear your filters.</p>
                    }
                    else
                    {
                        <p>Try adjusting your filters to see more products.</p>
                    }
                    <a class="hero-cta" asp-action="Index">Clear search and filters <span aria-hidden="true">→</span></a>
                </div>
            }
            else
            {
                <div class="product-grid catalog-product-grid">
                    @foreach (var product in Model.Products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="catalog-pagination" aria-label="Product pages">
                    @if (Model.CurrentPage > 1)
                    {
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-minimumPrice="@Model.MinimumPrice" asp-route-maximumPrice="@Model.MaximumPrice" asp-route-categoryId="@Model.CategoryId" asp-route-available="@Model.Available" asp-route-sort="@Model.Sort" asp-route-page="@(Model.CurrentPage - 1)">← Previous</a>
                    }
                    @for (var pageNumber = Math.Max(1, Model.CurrentPage - 2); pageNumber <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); pageNumber++)
                    {
                        if (pageNumber == Model.CurrentPage)
                        {
                            <span class="page-number current" aria-current="page">@pageNumber</span>
                        }
                        else
                        {
                            <a class="page-number" asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-minimumPrice="@Model.MinimumPrice" asp-route-maximumPrice="@Model.MaximumPrice" asp-route-categoryId="@Model.CategoryId" asp-route-available="@Model.Available" asp-route-sort="@Model.Sort" asp-route-page="@pageNumber">@pageNumber</a>
                        }
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a class="page-link" asp-action="Index" asp-route-q="@Model.SearchTerm" asp-route-minimumPrice="@Model.MinimumPrice" asp-route-maximumPrice="@Model.MaximumPrice" asp-route-categoryId="@Model.CategoryId" asp-route-available="@Model.Available" asp-route-sort="@Model.Sort" asp-route-page="@(Model.CurrentPage + 1)">Next →</a>
                    }
                </nav>
            }
        </div>
    </div>
</section>
