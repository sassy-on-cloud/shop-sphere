@model ShopSphere.Models.ProductCardViewModel

<article class="product-card h-100">
    <a class="product-image-wrap" asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" aria-label="View @Model.Name">
        <img class="product-image" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        <span class="product-badge">@Model.DiscountPercent.ToString("0.#")% OFF</span>
    </a>
    <div class="product-info">
        <h3 class="product-name">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Name</a>
        </h3>
        <div class="product-price">
            <strong>NPR @Model.Price.ToString("N0")</strong>
            <del>NPR @Model.OriginalPrice.ToString("N0")</del>
        </div>
        <div class="product-meta">
            <span>@Model.CategoryName</span>
        </div>
        <div class="stock-label">
            <span>@Model.Badge</span>
            <span>@Model.StockQuantity available</span>
        </div>
    </div>
</article>
