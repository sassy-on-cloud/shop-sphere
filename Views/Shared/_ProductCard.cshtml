@model ShopSphere.Models.ProductCardViewModel

<article class="product-card h-100">
    <a class="product-image-wrap" asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" aria-label="View @Model.Name">
        <img class="product-image" src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        @if (Model.DiscountPercent > 0)
        {
            <span class="product-badge">@Model.DiscountPercent.ToString("0.#")% OFF</span>
        }
    </a>
    <div class="product-info">
        <h3 class="product-name">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">@Model.Name</a>
        </h3>
        <div class="product-price">
            <strong>NPR @Model.Price.ToString("N2")</strong>
            @if (Model.DiscountPercent > 0)
            {
                <del>NPR @Model.OriginalPrice.ToString("N2")</del>
            }
        </div>
        <div class="product-meta">
            <span>@Model.CategoryName</span>
            <span class="product-rating-placeholder" aria-label="Rating not available">☆ New</span>
        </div>
        <div class="stock-label @(Model.StockQuantity > 0 ? "in-stock" : "out-of-stock")">
            <span>@Model.Badge</span>
            <span>@(Model.StockQuantity > 0 ? $"{Model.StockQuantity} available" : "Out of stock")</span>
        </div>
        <form class="product-card-cart-form" asp-controller="Cart" asp-action="Add" method="post">
            <input type="hidden" name="ProductId" value="@Model.ProductId" />
            <input type="hidden" name="Quantity" value="1" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" />
            <button class="cart-primary-button" type="submit" disabled="@(Model.StockQuantity <= 0)">Add to bag</button>
        </form>
    </div>
</article>
